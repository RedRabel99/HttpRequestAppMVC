@model HttpRequestAppMVC.Application.ViewModels.Requests.RequestVm

<h4>HttpRequestVm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" hidden>
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Url" class="control-label"></label>
                <input asp-for="Url" class="form-control" />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>
            <label>Method</label>
            @Html.DropDownListFor(method => method.Method, new SelectList(new[] { "GET", "POST", "PUT", "DELETE" }), "--Select--", new { @class = "form-control" })
            <p>RequestListId: @Model.RequestListId</p>
            @await Component.InvokeAsync("RequestListSelector", new { requestListId = Model.RequestListId });
            <div class="form-group">
                <label asp-for="Body" class="control-label"></label>
                <input asp-for="Body" class="form-control" />
                <span asp-validation-for="Body" class="text-danger"></span>
            </div>
            @* <div id="request-list-select-container"></div> *@

            <table>
                <thead>
                    <tr>
                        <th>Header</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody class="header-wrapper">

                    @for (var i = 0; i < Model.RequestHeaders.Count(); i++)
                    {
                        <tr>

                            <td>
                                @Html.HiddenFor(m => m.RequestHeaders[i].Id)
                                @Html.TextBoxFor(m => m.RequestHeaders[i].Header, new { @class = "form-control" })
                            </td>
                            <td>
                                @Html.TextBoxFor(model => model.RequestHeaders[i].Value, new { @class = "form-control" })
                            </td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm remove-header" data-id="@Model.RequestHeaders[i].Id">Remove</button>
                            </td>
                        </tr>
                    }
                    <tr class="header-template d-none">
                        <td>
                            <input type="hidden" name="RequestHeaders[__index__].Id" value="0" />
                            <input name="RequestHeaders[__index__].Header" class="form-control" />
                        </td>
                        <td>
                            <input name="RequestHeaders[__index__].Value" class="form-control" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm remove-header" data-id="">Remove</button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div id="deleted-headers-container"></div>
            <input type="button" id="add-header" value="Add header" class="btn btn-secondary" />



            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script>
               $(document).ready(function () {
            // Load request list
            $('#request-list-select-container').html('<div class="placeholder-select">Loading...</div>');
            $.get('/RequestList/CreateSelectedRequestList', function (html) {
                $('#request-list-select-container').html(html);
            });

            // Initial header index from model
            let headerIndex = @Model.RequestHeaders.Count;
            console.log('Initial header index:', headerIndex);

            // Track headers to delete
            let headersToDelete = [];
            let deleteIndex = 0;

            // Function to reindex headers
            function reindexHeaders() {
                // Get all visible header rows (excluding templates)
                const $rows = $('.header-wrapper tr').not('.header-template').not('.d-none');

                // Reindex each row
                $rows.each(function(idx) {
                    const $row = $(this);
                    $row.find('input[name^="RequestHeaders["]').each(function() {
                        const name = $(this).attr('name');
                        const newName = name.replace(/RequestHeaders\[\d+\]/g, `RequestHeaders[${idx}]`);
                        $(this).attr('name', newName);
                    });
                });

                // Update header index for new additions
                headerIndex = $rows.length;
                console.log('Updated header index after reindexing:', headerIndex);
            }

            // Add header button handler
            $('#add-header').on('click', function () {
                let $template = $('.header-template').clone();
                let html = $template.html().replaceAll(/__index__/g, headerIndex);
                let $newRow = $('<tr>' + html + '</tr>');
                $newRow.removeClass('d-none header-template');
                $('.header-wrapper').append($newRow);
                headerIndex++;
            });

            // Remove header button handler
            $(document).on('click', '.remove-header', function () {
                const $row = $(this).closest('tr');
                const headerId = $(this).data('id');

                // Add to deleted headers list if ID exists
                if (headerId && headerId !== '') {
                    $('#deleted-headers-container').append(
                        `<input type="hidden" name="HeadersToDelete[${deleteIndex}]" value="${headerId}" />`
                    );
                    deleteIndex++;
                }

                // Remove the row
                $row.remove();

                // Reindex remaining headers
                reindexHeaders();
            });
        });
    </script>
}
