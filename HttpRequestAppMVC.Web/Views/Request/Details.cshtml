@model HttpRequestAppMVC.Application.ViewModels.Requests.RequestVm

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>HttpRequestVm</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Url)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Url)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Method)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Method)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Body)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Body)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RequestListId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RequestListId)
        </dd>
        <table>
            <thead>
                <th>
                    Header
                </th>
                <th>Value</th>
            </thead>
            @foreach (var item in Model.RequestHeaders)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Header)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Value)
                    </td>
                </tr>
            }
        </table>
    </dl>
</div>
<div>
    @Html.ActionLink("Edit", "Edit", new {  id = Model.Id}) |
    @Html.DisplayFor(model => model.Name) |
    <a asp-action="Index">Back to List</a>
</div>
